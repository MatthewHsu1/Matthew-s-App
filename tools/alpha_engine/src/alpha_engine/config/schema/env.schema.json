{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnvConfig",
  "type": "object",
  "required": ["env_name", "mode", "strategy", "venue", "data", "risk", "reporting"],
  "additionalProperties": false,
  "properties": {
    "env_name": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_\\-]+$" },
    "mode": { "enum": ["backtest", "paper", "live"] },
    "strategy": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      }
    },
    "venue": {
      "type": "object",
      "required": ["id", "account_kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "account_kind": { "enum": ["paper", "live"] }
      }
    },
    "data": {
      "type": "object",
      "required": ["live_source", "historical_source", "instruments"],
      "additionalProperties": false,
      "properties": {
        "live_source": { "type": "string", "minLength": 1 },
        "historical_source": { "type": "string", "minLength": 1 },
        "instruments": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_position_usd": { "type": "number", "exclusiveMinimum": 0 },
        "max_daily_loss_usd": { "type": "number", "exclusiveMinimum": 0 },
        "price_band_bps": { "type": "integer", "minimum": 1 },
        "market_hours_only": { "type": "boolean" }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "benchmark": { "type": ["string", "null"] },
        "timezone": { "type": "string", "minLength": 1 }
      }
    }
  }
}
