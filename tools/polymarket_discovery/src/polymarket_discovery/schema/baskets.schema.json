{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/polymarket_discovery/baskets.schema.json",
  "title": "Polymarket Discovery Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_metadata",
    "markets",
    "dependencies",
    "baskets"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "run_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "generated_at_utc",
        "market_source",
        "embedding_model",
        "llm_model"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "generated_at_utc": {
          "type": "string",
          "minLength": 1
        },
        "market_source": {
          "type": "string",
          "minLength": 1
        },
        "embedding_model": {
          "type": "string",
          "minLength": 1
        },
        "llm_model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "markets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "market_id",
          "condition_id",
          "question",
          "description",
          "rules",
          "end_date",
          "topic",
          "token_ids"
        ],
        "properties": {
          "market_id": {
            "type": "string",
            "minLength": 1
          },
          "condition_id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "rules": {
            "type": "string"
          },
          "end_date": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "token_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "edge_type",
          "from_market_id",
          "to_market_id",
          "confidence",
          "rationale"
        ],
        "properties": {
          "edge_id": {
            "type": "string",
            "minLength": 1
          },
          "edge_type": {
            "type": "string",
            "minLength": 1
          },
          "from_market_id": {
            "type": "string",
            "minLength": 1
          },
          "to_market_id": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "baskets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "basket_id",
          "token_ids",
          "expected_sum",
          "dependency_basis"
        ],
        "properties": {
          "basket_id": {
            "type": "string",
            "minLength": 1
          },
          "token_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_sum": {
            "type": "number"
          },
          "dependency_basis": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
