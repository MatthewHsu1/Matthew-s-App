VLLM_IMAGE=vllm/vllm-openai:v0.6.6
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:1.7.2

HOST_BIND_ADDRESS=127.0.0.1

# Open-weight model placeholder for local chat inference.
VLLM_MODEL_ID=glm-open-weight-model-id
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_PORT=8000

TEI_MODEL_ID=linq-embed-mistral
TEI_PORT=8080

# Host cache paths.
HF_HOME_HOST=./.cache/huggingface
VLLM_CACHE_HOST=./.cache/vllm
TEI_CACHE_HOST=./.cache/tei

# Optional access token for gated model downloads from Hugging Face.
HF_TOKEN=

# Container cache paths.
HF_HOME=/data/hf
HF_HUB_CACHE=/data/hf/hub
TRANSFORMERS_CACHE=/data/hf/transformers
VLLM_CACHE_DIR=/data/vllm
TEI_CACHE_DIR=/data/tei

# Optional GPU settings.
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
