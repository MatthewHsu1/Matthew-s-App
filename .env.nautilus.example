# Copy this file to .env.nautilus and adjust values if needed.

# Upstream NautilusTrader repository.
NAUTILUS_REPO_URL=https://github.com/nautechsystems/nautilus_trader.git

# Pinned release tag for local checkout.
NAUTILUS_TRADER_TAG=v1.225.0

# Sidecar clone location.
NAUTILUS_CLONE_DIR=./tools/nautilus-trader

# Docker image used for smoke runs.
NAUTILUS_DOCKER_IMAGE=ghcr.io/nautechsystems/nautilus_trader:latest
